    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "svelte": "^5.56.0",
    "svelte-check": "^4.4.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "type": "module"
}
