{
  "name": "@testing-sites/monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build && pnpm clean && cp -r apps/next/out public/next && cp -r apps/nuxt/.output/public public/nuxt && cp -r apps/svelte-kit/build public/svelte-kit && cp -r apps/astro/dist public/astro",
    "clean": "rm -rf public/next public/nuxt public/svelte-kit public/astro",
    "preview": "ln -fs public testing-sites && http-server . -p 4200",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "private": true,
  "engines": {
    "node": "24"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@nx/js": "22.7.5",
    "@nx/workspace": "22.7.5",
    "nx": "22.7.5",
    "http-server": "14.1.1"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c"
}
